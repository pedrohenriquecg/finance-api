@baseUrl = http://localhost:8080
@token = paste-token-here

### Registrar usuario
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Pedro",
  "email": "pedro@email.com",
  "password": "password123"
}

###
### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "pedro@email.com",
  "password": "password123"
}

###
### Buscar perfil autenticado
GET {{baseUrl}}/users/me
Authorization: Bearer {{token}}

###
### Atualizar perfil autenticado
PUT {{baseUrl}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pedro Atualizado",
  "email": "novo@email.com"
}

###
### Deletar perfil autenticado
DELETE {{baseUrl}}/users/me
Authorization: Bearer {{token}}

###
### Registrar usuario invalido (deve retornar 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "",
  "email": "email-invalido",
  "password": "123"
}

###
### Criar transacao
POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Salario",
  "amount": 5000.00,
  "type": "INCOME",
  "category": "Salary",
  "date": "2026-06-22"
}

###
### Listar minhas transacoes
GET {{baseUrl}}/transactions
Authorization: Bearer {{token}}

###
### Meu resumo financeiro
GET {{baseUrl}}/transactions/summary
Authorization: Bearer {{token}}

###
### Buscar transacao por ID
GET {{baseUrl}}/transactions/1
Authorization: Bearer {{token}}

###
### Atualizar transacao
PUT {{baseUrl}}/transactions/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Mercado",
  "amount": 250.75,
  "type": "EXPENSE",
  "category": "Food",
  "date": "2026-06-22"
}

###
### Deletar transacao
DELETE {{baseUrl}}/transactions/1
Authorization: Bearer {{token}}

###
### Criar transacao invalida (deve retornar 400)
POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "",
  "amount": 0,
  "type": "EXPENSE",
  "category": "",
  "date": "2026-06-22"
}
